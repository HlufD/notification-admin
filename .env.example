# Base path of the notification service API as the browser sees it.
# Default: /v1.0/notification (served through the Vite dev proxy).
VITE_API_BASE=/v1.0/notification

# Where the dev proxy forwards /v1.0/... (read by vite.config.ts, not exposed to the browser).
NOTIFICATION_API_TARGET=http://localhost:3005

# Mock API with an in-memory database (default). The data is seeded on page load and
# resets on reload. Set to false to call the real notification service at VITE_API_BASE.
VITE_USE_MOCK=true
